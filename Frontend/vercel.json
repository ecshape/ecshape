{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sb-1onfq6wgmvku.vercel.run/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://sb-1onfq6wgmvku.vercel.run/uploads/:path*"
    },
    {
      "source": "/((?!assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
