{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api-production-9d8a41c7.up.railway.app/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://api-production-9d8a41c7.up.railway.app/uploads/$1"
    },
    {
      "source": "/((?!assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
